# Copy to .env to override. Every value below is the default, so .env is optional.
# These are throwaway local-dev credentials; never put real secrets in this file.

# Postgres
POSTGRES_USER=pourline
POSTGRES_PASSWORD=pourline
POSTGRES_DB=pourline

# SFTP drop (fake customer CSV uploads); shared by the sftp container and the simulators
SFTP_USER=pourline
SFTP_PASSWORD=pourline

# Simulators. Compose points MQTT and SFTP at the containers; these defaults suit `cargo run`.
MQTT_URL=mqtt://localhost:1883
SFTP_HOST=localhost
SFTP_PORT=2222
# Unset means the payloads are logged instead of posted (until ingest exists in M3).
BAUWERK_WEBHOOK_URL=
NECKAR_WEBHOOK_URL=
ORDER_INTERVAL_SECS=180
RHEINBAU_DROP_INTERVAL_SECS=300
TELEMATICS_DUPLICATE_RATE=0.03
TELEMATICS_REORDER_RATE=0.03
DEAD_ZONE_TRIP_SHARE=0.2
SIM_SEED=42
RUST_LOG=info
