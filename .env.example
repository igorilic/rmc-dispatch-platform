# Copy to .env to override. Every value below is the default, so .env is optional.
# These are throwaway local-dev credentials; never put real secrets in this file.

# Postgres
POSTGRES_USER=pourline
POSTGRES_PASSWORD=pourline
POSTGRES_DB=pourline

# SFTP drop (fake customer CSV uploads); shared by the sftp container, the simulators and ingest
SFTP_USER=pourline
SFTP_PASSWORD=pourline

# Webhook bearer tokens, shared by ingest and the simulators
WEBHOOK_TOKEN_BAUWERK_AG=dev-token-bauwerk-ag
WEBHOOK_TOKEN_NECKAR_INFRA=dev-token-neckar-infra

# Simulators. Compose points MQTT, SFTP and the webhooks at the containers; these defaults suit `cargo run`.
MQTT_URL=mqtt://localhost:1883
SFTP_HOST=localhost
SFTP_PORT=2222
# Unset means the payloads are logged instead of posted.
BAUWERK_WEBHOOK_URL=
NECKAR_WEBHOOK_URL=
ORDER_INTERVAL_SECS=180
RHEINBAU_DROP_INTERVAL_SECS=300
TELEMATICS_DUPLICATE_RATE=0.03
TELEMATICS_REORDER_RATE=0.03
DEAD_ZONE_TRIP_SHARE=0.2
SIM_SEED=42

# Ingest. Compose points NATS and MAPPINGS_DIR at the containers; these defaults suit `cargo run`.
HTTP_ADDR=0.0.0.0:8080
NATS_URL=nats://localhost:4222
SFTP_POLL_SECS=30
MAPPINGS_DIR=customers
MAX_IN_FLIGHT=64
DEDUP_TTL_DAYS=7

# Dispatch. Compose points Postgres and NATS at the containers; these defaults suit `cargo run`.
# Its own address variable, because every compose service reads this one .env.
DISPATCH_HTTP_ADDR=0.0.0.0:8081
DATABASE_URL=postgres://pourline:pourline@localhost:5432/pourline
# NATS_URL is shared with ingest (above).

RUST_LOG=info

LOCAL_SEARCH_BUDGET_MS=500
WEIGHT_COLD_JOINT_MINUTE=20
WEIGHT_GAP_MINUTE=1
WEIGHT_LATE_MINUTE=2
WEIGHT_EMPTY_KM=0.5
WEIGHT_CHURN_LOAD=10
TRUCK_REPAIR_MINUTES=60
DEMO_TIMEOUT_SECS=120

# Observability (M6). Compose points ingest and dispatch at Jaeger itself.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ADDR=0.0.0.0:9464
DISPATCH_METRICS_ADDR=0.0.0.0:9465
# Where make demo's closing links point
JAEGER_PUBLIC_URL=http://localhost:16686
GRAFANA_PUBLIC_URL=http://localhost:3000

# Plant-agent (milestone 7). compose and make k8s set the URLs and the database path.
PLANT_ID=plant-walldorf
PLANT_AGENT_DB=plant-agent.sqlite
PLANT_AGENT_HTTP_ADDR=0.0.0.0:8082
PLANT_AGENT_METRICS_ADDR=0.0.0.0:9466
PLAN_POLL_SECS=15
# Simulators: plants whose plant-agent sends the tickets (compose and make k8s set plant-walldorf).
# AGENT_PLANTS=

# ingest: what one process runs: all (compose), mqtt, webhooks or sftp-once (Kubernetes)
INGEST_MODE=all
# operator (Kubernetes only; the chart sets these)
INGEST_IMAGE=k3d-pourline-registry:5050/ingest:dev
OPERATOR_METRICS_ADDR=0.0.0.0:9467

# Shifts the simulated world's clock by whole hours, in every service. make demo and make k8s set it
# outside 06:00-16:00 Berlin time; 0 keeps the real clock.
# CLOCK_OFFSET_HOURS=0

# Map console (crates/console). make k8s runs it in the cloud cluster, where the chart sets all of
# these but CONSOLE_ADDR and CONSOLE_METRICS_ADDR. It also reads DISPATCH_URL, NATS_URL, MQTT_URL,
# PLANT_ID, BAUWERK_WEBHOOK_URL, NECKAR_WEBHOOK_URL, WEBHOOK_TOKEN_BAUWERK_AG,
# WEBHOOK_TOKEN_NECKAR_INFRA, CLOCK_OFFSET_HOURS, OTEL_EXPORTER_OTLP_ENDPOINT and RUST_LOG, with
# the same meaning as the other services.
# The page, its live stream and its API under /console/, and /healthz.
CONSOLE_ADDR=0.0.0.0:8083
CONSOLE_METRICS_ADDR=0.0.0.0:9468
# The address the browser uses: the header's links to Grafana, Jaeger and the API, and the only
# hosts (with 127.0.0.1 for localhost) allowed to change anything.
PUBLIC_URL=http://localhost:8080
# The plant-agent's /status over the plant's monitoring path. Empty: no edge card.
PLANT_AGENT_URL=
# The plant's uplink, Toxiproxy's API. Empty: no Make chaos.
UPLINK_URL=
# How long Make chaos cuts the uplink, in seconds.
CHAOS_SECONDS=120
